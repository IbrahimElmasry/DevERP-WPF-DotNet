<ui:FluentWindow x:Class="DevERP.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="DevERP — Business Operating System for Developers"
        Icon="Assets/app.ico"
        Height="820" Width="1280"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Foreground="#F8FAFC"
        Background="#090D16">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- TitleBar -->
            <RowDefinition Height="*"/>    <!-- Main Layout -->
        </Grid.RowDefinitions>

        <!-- Windows 11 Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="DevERP" Height="40">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                        <TextBlock Text="DevERP PRO" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                    </Border>
                    <TextBlock Text="•" FontSize="12" Foreground="#475569" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Profile.FullName}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                    <TextBlock Text=" (" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Profile.ProfessionalTitle}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    <TextBlock Text=")" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Body: Left Sidebar + Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Sidebar -->
            <Border Grid.Column="0" Background="#0C111C" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Brand / Logo -->
                        <RowDefinition Height="*"/>    <!-- Nav Buttons -->
                        <RowDefinition Height="Auto"/> <!-- Profile Badge Bottom -->
                    </Grid.RowDefinitions>

                    <!-- App Brand Header -->
                    <StackPanel Grid.Row="0" Margin="18,16,18,20">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#2563EB" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                                <TextBlock Text="D" FontSize="18" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="DevERP" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <TextBlock Text="Enterprise Suite" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Height="1" Background="#1E293B" Margin="0,16,0,0"/>
                    </StackPanel>

                    <!-- Navigation Items List -->
                    <StackPanel Grid.Row="1" Margin="10,0">
                        <!-- Dashboard -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left"
                                Padding="12,10" Margin="0,2" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Home24" FontSize="18" Margin="0,0,12,0" Foreground="#38BDF8"/>
                                <TextBlock Text="Dashboard" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Clients & Projects -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Clients"
                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left"
                                Padding="12,10" Margin="0,2" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="18" Margin="0,0,12,0" Foreground="#A78BFA"/>
                                <TextBlock Text="Clients &amp; Projects" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Invoices -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Invoices"
                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left"
                                Padding="12,10" Margin="0,2" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="18" Margin="0,0,12,0" Foreground="#34D399"/>
                                <TextBlock Text="Invoices &amp; Billing" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Cash Flow Ledger -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="CashFlow"
                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left"
                                Padding="12,10" Margin="0,2" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Money24" FontSize="18" Margin="0,0,12,0" Foreground="#F59E0B"/>
                                <TextBlock Text="Cash Flow Ledger" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Settings -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left"
                                Padding="12,10" Margin="0,2" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="18" Margin="0,0,12,0" Foreground="#94A3B8"/>
                                <TextBlock Text="Profile &amp; Settings" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Developer Identity Bottom Card -->
                    <Border Grid.Row="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,1,0,0" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#1E293B" CornerRadius="18" Width="36" Height="36" Margin="0,0,10,0">
                                <ui:SymbolIcon Symbol="Person24" FontSize="16" Foreground="#38BDF8"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Profile.FullName}" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Background="#064E3B" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                                        <TextBlock FontSize="9" FontWeight="Bold" Foreground="#34D399">
                                            <Run Text="Base: "/>
                                            <Run Text="{Binding Profile.BaseCurrency}"/>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="Online" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Toast Notification Banner -->
                    <RowDefinition Height="*"/>    <!-- Page Content -->
                </Grid.RowDefinitions>

                <!-- Modern Fluent InfoBar Notification Banner -->
                <ui:InfoBar Grid.Row="0" Margin="24,12,24,0"
                            IsOpen="{Binding IsStatusMessageVisible, Mode=TwoWay}"
                            IsClosable="True"
                            Title="{Binding NotificationTitle}"
                            Message="{Binding StatusMessage}"
                            Severity="{Binding NotificationSeverity}" />

                <!-- Active View Model Content -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"/>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
