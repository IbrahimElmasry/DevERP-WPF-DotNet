<ui:FluentWindow x:Class="DevERP.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="DevERP — Business Operating System for Developers"
        Icon="pack://application:,,,/DevERP.Wpf;component/Assets/app.ico"
        Height="820" Width="1280"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Foreground="#F8FAFC"
        Background="#090D16">

    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenCommandPaletteCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CloseCommandPaletteCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- Modern Nav Button Style -->
        <Style x:Key="ModernNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#141E30"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#22324C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A2840"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Native Window TitleBar -->
            <RowDefinition Height="Auto"/> <!-- Full-Width Workspace Header -->
            <RowDefinition Height="*"/>    <!-- Main Layout -->
        </Grid.RowDefinitions>

        <!-- Windows 11 Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="DevERP PRO — Executive Workspace" Height="34"/>

        <!-- Top Workspace Bar (Spans full window width, centered Raycast search, architect badge) -->
        <Border Grid.Row="1" Background="#0C111C" BorderBrush="#1C273C" BorderThickness="0,0,0,1" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: App Brand & Page Indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0C1B2E" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                        <TextBlock Text="DevERP PRO" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                    </Border>
                    <TextBlock Text="{Binding CurrentViewTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: Quick Command Palette Trigger (Raycast/Linear style) -->
                <Button Grid.Column="1" HorizontalAlignment="Center"
                        Command="{Binding OpenCommandPaletteCommand}"
                        Cursor="Hand" Width="380"
                        ToolTip="Quick Command Palette (Ctrl + K)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SearchBd" Background="#0E1626" BorderBrush="#1C2B42" BorderThickness="1" CornerRadius="8" Padding="14,6">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Search24" FontSize="13" Foreground="#64748B" Margin="0,0,8,0"/>
                                        <TextBlock Text="Search clients, invoices, ledger..." FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="#162238" BorderBrush="#253550" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="Ctrl + K" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SearchBd" Property="Background" Value="#131F33"/>
                                    <Setter TargetName="SearchBd" Property="BorderBrush" Value="#0284C7"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="SearchBd" Property="Background" Value="#172740"/>
                                    <Setter TargetName="SearchBd" Property="BorderBrush" Value="#38BDF8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Right: Architect Badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Lead Architect: " FontSize="11" Foreground="#475569"/>
                    <TextBlock Text="Eng. Ibrahim Tarek" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: Left Sidebar + Content Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Sidebar -->
            <Border Grid.Column="0" Background="#0C111C" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Brand / Logo -->
                        <RowDefinition Height="*"/>    <!-- Nav Buttons -->
                        <RowDefinition Height="Auto"/> <!-- Profile Badge Bottom -->
                    </Grid.RowDefinitions>

                    <!-- App Brand Header -->
                    <Border Grid.Row="0" Margin="14,14,14,16" Padding="12,10" Background="#111826" BorderBrush="#1D283A" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="10" Width="42" Height="42" Margin="0,0,10,0" Background="#080D18" BorderBrush="#1E293B" BorderThickness="1.2" Padding="2">
                                <Image Source="pack://application:,,,/DevERP.Wpf;component/Assets/brand_logo.png" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="DevERP" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <Border Background="#064E3B" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="PRO" FontSize="8" FontWeight="Bold" Foreground="#34D399"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Eng. Ibrahim Tarek" FontSize="10.5" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Navigation Items List -->
                    <StackPanel Grid.Row="1" Margin="10,0">
                        <!-- Dashboard -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                Background="{Binding CurrentViewTag, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter=Dashboard}"
                                BorderBrush="{Binding CurrentViewTag, Converter={StaticResource EqualityToBorderBrushConverter}, ConverterParameter=Dashboard}"
                                Style="{StaticResource ModernNavButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="3" Height="16" CornerRadius="1.5" Background="#38BDF8" Margin="0,0,8,0"
                                        Visibility="{Binding CurrentViewTag, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Dashboard}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border Background="#0E2338" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Home24" FontSize="15" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Dashboard" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Clients & Projects -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Clients"
                                Background="{Binding CurrentViewTag, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter=Clients}"
                                BorderBrush="{Binding CurrentViewTag, Converter={StaticResource EqualityToBorderBrushConverter}, ConverterParameter=Clients}"
                                Style="{StaticResource ModernNavButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="3" Height="16" CornerRadius="1.5" Background="#A78BFA" Margin="0,0,8,0"
                                        Visibility="{Binding CurrentViewTag, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Clients}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border Background="#1C1838" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="15" Foreground="#A78BFA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Clients &amp; Projects" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Invoices -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Invoices"
                                Background="{Binding CurrentViewTag, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter=Invoices}"
                                BorderBrush="{Binding CurrentViewTag, Converter={StaticResource EqualityToBorderBrushConverter}, ConverterParameter=Invoices}"
                                Style="{StaticResource ModernNavButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="3" Height="16" CornerRadius="1.5" Background="#34D399" Margin="0,0,8,0"
                                        Visibility="{Binding CurrentViewTag, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Invoices}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border Background="#063223" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="15" Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Invoices &amp; Billing" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Cash Flow Ledger -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="CashFlow"
                                Background="{Binding CurrentViewTag, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter=CashFlow}"
                                BorderBrush="{Binding CurrentViewTag, Converter={StaticResource EqualityToBorderBrushConverter}, ConverterParameter=CashFlow}"
                                Style="{StaticResource ModernNavButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="3" Height="16" CornerRadius="1.5" Background="#F59E0B" Margin="0,0,8,0"
                                        Visibility="{Binding CurrentViewTag, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=CashFlow}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border Background="#351C05" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Money24" FontSize="15" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Cash Flow Ledger" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Settings -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                Background="{Binding CurrentViewTag, Converter={StaticResource EqualityToBrushConverter}, ConverterParameter=Settings}"
                                BorderBrush="{Binding CurrentViewTag, Converter={StaticResource EqualityToBorderBrushConverter}, ConverterParameter=Settings}"
                                Style="{StaticResource ModernNavButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="3" Height="16" CornerRadius="1.5" Background="#94A3B8" Margin="0,0,8,0"
                                        Visibility="{Binding CurrentViewTag, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Settings}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border Background="#172033" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Settings24" FontSize="15" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Profile &amp; Settings" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Developer Identity Bottom Card -->
                    <Border Grid.Row="2" Background="#0F1624" BorderBrush="#1C273C" BorderThickness="1" CornerRadius="10" Margin="12" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#162238" CornerRadius="16" Width="32" Height="32" Margin="0,0,10,0" BorderBrush="#253550" BorderThickness="1">
                                <ui:SymbolIcon Symbol="Person24" FontSize="15" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Profile.FullName}" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Background="#064E3B" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                        <TextBlock FontSize="9" FontWeight="Bold" Foreground="#34D399">
                                            <Run Text="Base: "/>
                                            <Run Text="{Binding Profile.BaseCurrency}"/>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="Online" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Quick Lock App Button -->
                            <Button Grid.Column="2" Command="{Binding LockAppCommand}" ToolTip="Lock DevERP (PIN)"
                                    Background="Transparent" BorderThickness="0" Padding="6" Cursor="Hand"
                                    Foreground="#64748B" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="LockClosed24" FontSize="16"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Toast Notification Banner -->
                    <RowDefinition Height="*"/>    <!-- Page Content -->
                </Grid.RowDefinitions>

                <!-- Modern Fluent InfoBar Notification Banner -->
                <ui:InfoBar Grid.Row="0" Margin="24,12,24,0"
                            IsOpen="{Binding IsStatusMessageVisible, Mode=TwoWay}"
                            IsClosable="True"
                            Title="{Binding NotificationTitle}"
                            Message="{Binding StatusMessage}"
                            Severity="{Binding NotificationSeverity}" />

                <!-- Active View Model Content -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"/>
            </Grid>
        </Grid>

        <!-- ============================================================ -->
        <!-- COMMAND PALETTE MODAL OVERLAY (RAYCAST / LINEAR STYLE)       -->
        <!-- ============================================================ -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Panel.ZIndex="2000"
              Visibility="{Binding IsCommandPaletteOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

            <!-- Translucent Backdrop (Clicking backdrop dismisses palette) -->
            <Border Background="#D9030712" MouseLeftButtonDown="Backdrop_MouseLeftButtonDown"/>

            <!-- Centered Modal Card -->
            <Border Width="650" MaxHeight="520"
                    VerticalAlignment="Top" HorizontalAlignment="Center"
                    Margin="0,85,0,0"
                    Background="#0D131F"
                    BorderBrush="#253550"
                    BorderThickness="1"
                    CornerRadius="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Direction="270" ShadowDepth="12" Opacity="0.75" Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search Header Bar -->
                        <RowDefinition Height="*"/>    <!-- Scrollable Results List -->
                        <RowDefinition Height="Auto"/> <!-- Footer Key Hints -->
                    </Grid.RowDefinitions>

                    <!-- Search Input Box -->
                    <Border Grid.Row="0" BorderBrush="#1C273C" BorderThickness="0,0,0,1" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon Grid.Column="0" Symbol="Search24" FontSize="18" Foreground="#38BDF8" Margin="0,0,12,0" VerticalAlignment="Center"/>

                            <TextBox x:Name="PaletteSearchBox" Grid.Column="1"
                                     Text="{Binding CommandPaletteSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14" FontWeight="Medium"
                                     Foreground="#F8FAFC"
                                     CaretBrush="#38BDF8"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     VerticalAlignment="Center"
                                     KeyDown="PaletteSearchBox_KeyDown"/>

                            <!-- Close Button -->
                            <Button Grid.Column="2" Command="{Binding CloseCommandPaletteCommand}"
                                    Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand"
                                    Foreground="#64748B" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="16"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Results List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="380" Padding="8,8">
                        <ItemsControl ItemsSource="{Binding CommandPaletteResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.ExecutePaletteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="10,8"
                                            Margin="0,1"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ItemBd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Icon pill with dynamic tint -->
                                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#141E33" Margin="0,0,12,0">
                                                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="15" Foreground="{Binding IconColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Text Details -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>

                                                        <!-- Category Badge -->
                                                        <Border Grid.Column="2" Background="#162238" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBd" Property="Background" Value="#172338"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="ItemBd" Property="Background" Value="#1E314F"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Footer / Keyboard shortcuts helper -->
                    <Border Grid.Row="2" Background="#0A0E17" BorderBrush="#1C273C" BorderThickness="0,1,0,0" Padding="14,8" CornerRadius="0,0,14,14">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#162238" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                                    <TextBlock Text="ESC" FontSize="9" FontWeight="Bold" Foreground="#94A3B8"/>
                                </Border>
                                <TextBlock Text="to close" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                <Border Background="#162238" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                                    <TextBlock Text="↵" FontSize="9" FontWeight="Bold" Foreground="#94A3B8"/>
                                </Border>
                                <TextBlock Text="to select" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock HorizontalAlignment="Right" Text="DevERP Command Center" FontSize="10.5" Foreground="#475569" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
