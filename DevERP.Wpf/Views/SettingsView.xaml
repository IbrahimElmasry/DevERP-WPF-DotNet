<UserControl x:Class="DevERP.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Settings &amp; Developer Identity" FontSize="22" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Configure profile metadata, international wire bank details, base currency, and SQLite database backups." FontSize="13" Foreground="#94A3B8" Margin="0,3,0,0"/>
                </StackPanel>

                <Button HorizontalAlignment="Right" Command="{Binding SaveSettingsCommand}"
                        Background="#2563EB" BorderBrush="#3B82F6" Foreground="White" Padding="16,8">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Save24" FontSize="16" Margin="0,0,6,0"/>
                        <TextBlock Text="Save Changes" FontSize="13" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Section 1: Developer Identity -->
            <Border Grid.Row="1" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <ui:SymbolIcon Symbol="Person24" Foreground="#38BDF8" FontSize="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Developer Identity &amp; Contact Information" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Full Legal Name *" FontSize="11" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding Profile.FullName, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Professional Title / Tagline" FontSize="11" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding Profile.ProfessionalTitle, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Email Address" FontSize="11" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding Profile.Email, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Phone Number" FontSize="11" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding Profile.Phone, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Billing Address (Printed on Invoices)" FontSize="11" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding Profile.Address, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tax ID / Registration Number" FontSize="11" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding Profile.TaxNumber, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Custom Invoice Logo Upload -->
                    <Border Height="1" Background="#1E293B" Margin="0,14,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Invoice Brand Logo (.PNG, .JPG)" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding Profile.LogoPath, TargetNullValue='No logo uploaded (Vector DevERP badge used)'}"
                                       FontSize="11" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding UploadLogoCommand}"
                                    Background="#1E293B" BorderBrush="#38BDF8" Foreground="#F8FAFC" Padding="12,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Image24" FontSize="14" Margin="0,0,6,0" Foreground="#38BDF8"/>
                                    <TextBlock Text="Upload Logo" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding RemoveLogoCommand}"
                                    Background="Transparent" BorderBrush="#EF4444" Foreground="#EF4444" Padding="10,6">
                                <TextBlock Text="Remove" FontSize="11"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 2: Bank Wire & InstaPay Coordinates -->
            <Border Grid.Row="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <ui:SymbolIcon Symbol="BuildingBank24" Foreground="#34D399" FontSize="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Bank Wire &amp; InstaPay Egypt (IPN) Coordinates" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Bank Name *" FontSize="11" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding Profile.BankName, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Account Holder / Beneficiary Name *" FontSize="11" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding Profile.BankAccountHolder, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="International Bank Account Number (IBAN) *" FontSize="11" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding Profile.Iban, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,3,0,0" FontFamily="Consolas"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SWIFT / BIC Code *" FontSize="11" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding Profile.SwiftBic, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,3,0,0" FontFamily="Consolas"/>
                        </StackPanel>
                    </Grid>

                    <!-- InstaPay Egypt (IPN) Sub-section -->
                    <Border Height="1" Background="#1E293B" Margin="0,6,0,14"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Background="#064E3B" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="INSTAPAY IPN" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                        </Border>
                        <TextBlock Text="InstaPay Egypt Instant Payment Details" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="InstaPay Payment Address (IPA / Handle) *" FontSize="11" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding Profile.InstaPayAddress, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" BorderBrush="#334155" Foreground="#34D399" Margin="0,3,0,0" FontFamily="Consolas"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="InstaPay Registered Mobile Number *" FontSize="11" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding Profile.InstaPayPhone, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,3,0,0" FontFamily="Consolas"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 3: Currency & FX Rates with Live Sync -->
            <Border Grid.Row="3" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <ui:SymbolIcon Symbol="Money24" Foreground="#F59E0B" FontSize="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Currency &amp; Foreign Exchange Defaults" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Base Currency" FontSize="11" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding Profile.BaseCurrency, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="USD to EGP" FontSize="11" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding Profile.UsdToEgpRate, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="EUR to EGP" FontSize="11" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding Profile.EurToEgpRate, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="SAR to EGP" FontSize="11" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding Profile.SarToEgpRate, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Sync Live Rates Button -->
                        <Button Grid.Column="8" Command="{Binding SyncLiveFxRatesCommand}" VerticalAlignment="Bottom"
                                Background="#1E293B" BorderBrush="#0284C7" Foreground="#38BDF8" Padding="14,7" Cursor="Hand" Margin="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Sync Live Rates" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 4: Security & Authentication (4-Digit PIN) -->
            <Border Grid.Row="4" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <ui:SymbolIcon Symbol="ShieldKeyhole24" Foreground="#38BDF8" FontSize="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Security &amp; PIN Authentication" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- PIN Enabled Toggle / CheckBox -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="App Startup Protection" FontSize="11" Foreground="#94A3B8"/>
                            <CheckBox Content="Require 4-digit PIN on App Startup &amp; Lock"
                                      IsChecked="{Binding Profile.IsPinEnabled, Mode=TwoWay}"
                                      Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,4"/>
                            <TextBlock Text="Protects your financial ledger, invoices, and bank coordinates when launching the app or stepping away."
                                       FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- 4-Digit PIN Input -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="4-Digit Security PIN Code *" FontSize="11" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding Profile.SecurityPin, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="4" FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                     Background="#1E293B" BorderBrush="#334155" Foreground="#38BDF8" Margin="0,6,0,4"
                                     HorizontalContentAlignment="Center" Width="140" HorizontalAlignment="Left"/>
                            <TextBlock Text="Must be exactly 4 numbers (0-9). Default is 1234."
                                       FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 5: SQLite Database & Backup / Restore -->
            <Border Grid.Row="5" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="Database24" Foreground="#A78BFA" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="SQLite Database Storage, Backup &amp; Restore" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="#94A3B8">
                            <Run Text="Local SQLite File Location: "/>
                            <Run Text="{Binding DatabasePath}" Foreground="#38BDF8" FontFamily="Consolas"/>
                        </TextBlock>
                        <TextBlock Text="Perform full offsite or local database backups to safeguard your financial ledger, invoices, and client records." FontSize="11" Foreground="#64748B" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Export & Restore Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ExportDatabaseBackupCommand}"
                                Background="#1E293B" BorderBrush="#475569" Foreground="#F8FAFC" Padding="14,8" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Margin="0,0,6,0" Foreground="#38BDF8"/>
                                <TextBlock Text="Export Backup" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding RestoreDatabaseBackupCommand}"
                                Background="#1E293B" BorderBrush="#F43F5E" Foreground="#FDA4AF" Padding="14,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="16" Margin="0,0,6,0" Foreground="#F43F5E"/>
                                <TextBlock Text="Restore Backup" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Section 6: Windows Desktop Integration & Shortcuts -->
            <Border Grid.Row="6" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="Desktop24" Foreground="#38BDF8" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Windows Desktop Integration" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                        </StackPanel>
                        <TextBlock Text="Install a native Windows shell shortcut (.lnk) on your Desktop for one-click launching with the DevERP icon."
                                   FontSize="12" Foreground="#94A3B8"/>
                        <TextBlock Text="The shortcut automatically pins the current executable path and sets the working directory."
                                   FontSize="11" Foreground="#64748B" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Create Desktop Shortcut Button -->
                    <Button Grid.Column="1" Command="{Binding CreateDesktopShortcutCommand}" VerticalAlignment="Center"
                            Background="#0369A1" BorderBrush="#38BDF8" Foreground="White" Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Link24" FontSize="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Create Desktop Shortcut" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Section 7: Lead Architect & Systems Engineering Credentials -->
            <Border Grid.Row="7" Background="#0C1322" BorderBrush="#1E2E48" BorderThickness="1" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar Badge -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#17253D" BorderBrush="#38BDF8" BorderThickness="1.5" Margin="0,0,14,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Code24" FontSize="20" Foreground="#38BDF8"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Designed &amp; Engineered by " FontSize="14" Foreground="#94A3B8"/>
                                <TextBlock Text="Eng. Ibrahim Tarek" FontSize="14" FontWeight="Bold" Foreground="#38BDF8"/>
                                <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                    <TextBlock Text="DevERP v1.0.0 LTS" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Lead Systems Architect &amp; ASP.NET Core Specialist • Alexandria, Egypt" FontSize="11" Foreground="#64748B" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Contact & Portfolio Quick Links -->
                    <WrapPanel Grid.Row="1" Margin="0,14,0,0">
                        <Button Command="{Binding OpenUrlCommand}" CommandParameter="https://ibrahimelmasry.github.io/"
                                Background="#162238" BorderBrush="#253550" Foreground="#F8FAFC" Margin="0,0,8,6" Padding="12,6" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Globe24" FontSize="14" Margin="0,0,6,0" Foreground="#38BDF8"/>
                                <TextBlock Text="Portfolio" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/IbrahimElmasry"
                                Background="#162238" BorderBrush="#253550" Foreground="#F8FAFC" Margin="0,0,8,6" Padding="12,6" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Branch24" FontSize="14" Margin="0,0,6,0" Foreground="#A78BFA"/>
                                <TextBlock Text="GitHub Profile" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenUrlCommand}" CommandParameter="https://www.linkedin.com/in/ibrahim-tarek-62b0a62a4/"
                                Background="#162238" BorderBrush="#253550" Foreground="#F8FAFC" Margin="0,0,8,6" Padding="12,6" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="People24" FontSize="14" Margin="0,0,6,0" Foreground="#60A5FA"/>
                                <TextBlock Text="LinkedIn" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenUrlCommand}" CommandParameter="https://wa.me/201019804919"
                                Background="#162238" BorderBrush="#253550" Foreground="#F8FAFC" Margin="0,0,8,6" Padding="12,6" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Chat24" FontSize="14" Margin="0,0,6,0" Foreground="#34D399"/>
                                <TextBlock Text="WhatsApp Direct" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
