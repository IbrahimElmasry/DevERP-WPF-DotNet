<UserControl x:Class="DevERP.Desktop.Views.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">
    <Grid Margin="24">
        <!-- Main Layout: Left Clients Master List, Right Details & Projects -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Clients List -->
        <Border Grid.Column="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header & Add Button -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Clients" FontSize="18" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Command="{Binding OpenAddClientCommand}"
                            Background="#2563EB" BorderBrush="#3B82F6" Foreground="White" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,4,0"/>
                            <TextBlock Text="New" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Search Input with rounded border & clear button -->
                <Border Grid.Row="1" CornerRadius="8" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,12" Padding="6,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Search24" FontSize="14" Foreground="#94A3B8" Margin="4,0,6,0" VerticalAlignment="Center"/>
                        <ui:TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                    Background="Transparent" BorderThickness="0" Foreground="#F8FAFC" Padding="4,4"
                                    PlaceholderText="Search by name, company..."/>
                        <Button Grid.Column="2" Command="{Binding ClearSearchCommand}"
                                Background="Transparent" BorderThickness="0" Padding="4"
                                Visibility="{Binding SearchText, Converter={StaticResource NullToVisibilityConverter}}"
                                ToolTip="Clear search text">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" Foreground="#94A3B8"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Client List View with modern card styling and high contrast -->
                <ListBox Grid.Row="2" ItemsSource="{Binding FilteredClients}" SelectedItem="{Binding SelectedClient}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="#162032"
                                                BorderBrush="#253349"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Left Accent indicator -->
                                                <Border x:Name="AccentBar" Grid.Column="0"
                                                        Background="Transparent"
                                                        CornerRadius="2"
                                                        Margin="0,2,0,2"/>

                                                <!-- Content -->
                                                <ContentPresenter Grid.Column="1" Margin="10,0,6,0"/>

                                                <!-- Quick Delete button -->
                                                <Button x:Name="QuickDelBtn" Grid.Column="2"
                                                        Command="{Binding DataContext.DeleteClientCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="4"
                                                        Opacity="0.4"
                                                        ToolTip="Delete this client"
                                                        VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="#F87171"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#1E2D44"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#38BDF8"/>
                                                <Setter TargetName="QuickDelBtn" Property="Opacity" Value="1.0"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#0F2847"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#38BDF8"/>
                                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1.5"/>
                                                <Setter TargetName="AccentBar" Property="Background" Value="#38BDF8"/>
                                                <Setter TargetName="QuickDelBtn" Property="Opacity" Value="1.0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="{Binding Company}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,2,0,0"
                                           Visibility="{Binding Company, Converter={StaticResource NullToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding Email}" FontSize="11" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Right Column: Client & Project Details -->
        <Border Grid.Column="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="20">
            <Grid>
                <!-- If no client selected -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding SelectedClient, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}">
                    <ui:SymbolIcon Symbol="PersonAccounts24" FontSize="48" Foreground="#334155" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="No Client Selected" FontSize="16" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                    <TextBlock Text="Select a client from the list or click '+ New' to create a client workspace."
                               FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Client Content -->
                <Grid Visibility="{Binding SelectedClient, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Client Header -->
                        <RowDefinition Height="Auto"/> <!-- Projects Ribbon -->
                        <RowDefinition Height="*"/>    <!-- Selected Project Milestones -->
                    </Grid.RowDefinitions>

                    <!-- Client Header Information -->
                    <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedClient.Name}" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <Border Background="#0C4A6E" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding SelectedClient.Company, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="{Binding SelectedClient.Company}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                    </Border>
                                </StackPanel>

                                <!-- Contact Information Badges -->
                                <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <!-- Email -->
                                    <Border Background="#1E293B" CornerRadius="4" Padding="8,4" Margin="0,0,8,4"
                                            Visibility="{Binding SelectedClient.Email, Converter={StaticResource NullToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Mail24" FontSize="13" Foreground="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SelectedClient.Email}" FontSize="11.5" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Phone -->
                                    <Border Background="#1E293B" CornerRadius="4" Padding="8,4" Margin="0,0,8,4"
                                            Visibility="{Binding SelectedClient.Phone, Converter={StaticResource NullToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Call24" FontSize="13" Foreground="#34D399" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SelectedClient.Phone}" FontSize="11.5" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Address -->
                                    <Border Background="#1E293B" CornerRadius="4" Padding="8,4" Margin="0,0,8,4"
                                            Visibility="{Binding SelectedClient.Address, Converter={StaticResource NullToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Location24" FontSize="13" Foreground="#FBBF24" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SelectedClient.Address}" FontSize="11.5" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Header Actions -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                <!-- Add Project Button -->
                                <Button Command="{Binding OpenAddProjectCommand}" Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC" Padding="10,6" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,6,0" Foreground="#38BDF8"/>
                                        <TextBlock Text="Add Project" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <!-- Clear Selection Button -->
                                <Button Command="{Binding ClearSelectionCommand}" Background="#1E293B" BorderBrush="#334155" Foreground="#CBD5E1" Padding="10,6" Margin="0,0,8,0"
                                        ToolTip="Close details and clear selection">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Margin="0,0,6,0" Foreground="#94A3B8"/>
                                        <TextBlock Text="Clear Selection" FontSize="12"/>
                                    </StackPanel>
                                </Button>

                                <!-- Delete Client Button -->
                                <Button Command="{Binding DeleteClientCommand}" Background="#450A0A" BorderBrush="#DC2626" Foreground="#FCA5A5" Padding="10,6"
                                        ToolTip="Permanently remove this client and its projects">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,6,0" Foreground="#F87171"/>
                                        <TextBlock Text="Delete Client" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Projects Tab / Ribbon -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Client Projects" FontSize="14" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>

                        <ListBox Grid.Row="1" ItemsSource="{Binding ClientProjects}" SelectedItem="{Binding SelectedProject}"
                                 Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,10,6"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ProjectCardBorder"
                                                        Background="#1E293B"
                                                        BorderBrush="#334155"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="12,10"
                                                        MinWidth="200">
                                                    <Grid>
                                                        <ContentPresenter/>
                                                        <!-- Delete Project button -->
                                                        <Button Command="{Binding DataContext.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="4"
                                                                Margin="0,-6,-6,0"
                                                                Opacity="0.4"
                                                                ToolTip="Delete this project">
                                                            <ui:SymbolIcon Symbol="Delete24" FontSize="13" Foreground="#F87171"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ProjectCardBorder" Property="Background" Value="#24334A"/>
                                                        <Setter TargetName="ProjectCardBorder" Property="BorderBrush" Value="#38BDF8"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ProjectCardBorder" Property="Background" Value="#0F2847"/>
                                                        <Setter TargetName="ProjectCardBorder" Property="BorderBrush" Value="#38BDF8"/>
                                                        <Setter TargetName="ProjectCardBorder" Property="BorderThickness" Value="1.5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border Background="#0F172A" BorderBrush="{Binding Status, Converter={StaticResource ProjectStatusToBrushConverter}}"
                                                    BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{Binding Status, Converter={StaticResource ProjectStatusToBrushConverter}}"/>
                                            </Border>
                                            <TextBlock FontSize="11" Foreground="#CBD5E1">
                                                <Run Text="Budget: "/>
                                                <Run Text="{Binding TotalBudget, StringFormat={}{0:N0}}" FontWeight="Bold" Foreground="#38BDF8"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Milestones Section for Selected Project -->
                    <Border Grid.Row="2" Background="#0B132B" BorderBrush="#1C2541" BorderThickness="1" CornerRadius="8" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Milestone Header & Actions -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Project Milestones &amp; Billing" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="{Binding SelectedProject.Name, StringFormat={}({0})}" FontSize="13" Foreground="#38BDF8" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button Command="{Binding OpenAddMilestoneCommand}" Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC" Padding="10,5" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,6,0" Foreground="#38BDF8"/>
                                            <TextBlock Text="Add Milestone" FontSize="12"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Direct Action: Generate Invoice From Selected Milestones -->
                                    <Button Command="{Binding GenerateInvoiceFromMilestonesCommand}"
                                            Background="#059669" BorderBrush="#10B981" Foreground="White" Padding="12,5">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ReceiptMoney24" FontSize="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Generate Invoice from Selected" FontSize="12" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Milestone List with clear details and stylish completion button -->
                            <ListView Grid.Row="1" ItemsSource="{Binding ProjectMilestones}" Background="Transparent" BorderThickness="0">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,4"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border Background="#101A2E" BorderBrush="#1E2B42" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> <!-- Selection Checkbox for Invoicing -->
                                                <ColumnDefinition Width="*"/>    <!-- Milestone Info -->
                                                <ColumnDefinition Width="Auto"/> <!-- Status & Completion Toggle -->
                                                <ColumnDefinition Width="Auto"/> <!-- Amount -->
                                                <ColumnDefinition Width="Auto"/> <!-- Delete Button -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Checkbox for invoice selection -->
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,14,0"
                                                      ToolTip="Select for invoice generation"
                                                      IsEnabled="{Binding Milestone.IsInvoiced, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}"/>

                                            <!-- Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Milestone.Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                    <Border Background="#0C4A6E" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="10,0,0,0"
                                                            Visibility="{Binding Milestone.IsInvoiced, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="INVOICED" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Milestone.Description}" FontSize="11.5" Foreground="#CBD5E1" Margin="0,3,0,0"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding Milestone.Description, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="12" Foreground="#94A3B8" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center">
                                                        <Run Text="Due: "/>
                                                        <Run Text="{Binding Milestone.DueDate, StringFormat={}{0:yyyy-MM-dd}}" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Completion button/toggle (Polished: "Completed" vs "Mark Complete") -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <Button Command="{Binding DataContext.ToggleMilestoneCompleteCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                        CommandParameter="{Binding}"
                                                        Background="{Binding StatusBackground}"
                                                        BorderBrush="{Binding StatusBorder}"
                                                        BorderThickness="1"
                                                        Padding="10,4"
                                                        Cursor="Hand"
                                                        ToolTip="Click to toggle completion status">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="13" Margin="0,0,6,0"
                                                                       Foreground="{Binding StatusForeground}"/>
                                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{Binding StatusForeground}"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <!-- Amount -->
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="14.5" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" Margin="0,0,16,0">
                                                <Run Text="{Binding Milestone.Amount, StringFormat={}{0:N2}}"/>
                                            </TextBlock>

                                            <!-- Delete Milestone Button -->
                                            <Button Grid.Column="4"
                                                    Command="{Binding DataContext.DeleteMilestoneCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="6"
                                                    Cursor="Hand"
                                                    ToolTip="Delete Milestone">
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="15" Foreground="#F87171"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Add Client Modal Overlay -->
        <Grid Grid.ColumnSpan="3" Background="#80000000" Visibility="{Binding IsAddClientOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Width="460" Padding="20" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Add New Client" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,14"/>

                    <TextBlock Text="Client / Contact Name *" FontSize="11" Foreground="#94A3B8"/>
                    <TextBox Text="{Binding NewClientName, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,10"/>

                    <TextBlock Text="Company Name" FontSize="11" Foreground="#94A3B8"/>
                    <TextBox Text="{Binding NewClientCompany, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,10"/>

                    <TextBlock Text="Email Address" FontSize="11" Foreground="#94A3B8"/>
                    <TextBox Text="{Binding NewClientEmail, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,10"/>

                    <TextBlock Text="Phone" FontSize="11" Foreground="#94A3B8"/>
                    <TextBox Text="{Binding NewClientPhone, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,10"/>

                    <TextBlock Text="Billing Address" FontSize="11" Foreground="#94A3B8"/>
                    <TextBox Text="{Binding NewClientAddress, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,10"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Cancel" Command="{Binding OpenAddClientCommand}" Background="Transparent" BorderBrush="#475569" Foreground="#94A3B8" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="Save Client" Command="{Binding SaveClientCommand}" Background="#2563EB" BorderBrush="#3B82F6" Foreground="White" Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Add Project Modal Overlay -->
        <Grid Grid.ColumnSpan="3" Background="#80000000" Visibility="{Binding IsAddProjectOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Width="460" Padding="20" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Add New Project" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,14"/>

                    <TextBlock Text="Project Name *" FontSize="11" Foreground="#94A3B8"/>
                    <TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,10"/>

                    <TextBlock Text="Description" FontSize="11" Foreground="#94A3B8"/>
                    <TextBox Text="{Binding NewProjectDescription, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,10"/>

                    <TextBlock Text="Total Budget" FontSize="11" Foreground="#94A3B8"/>
                    <TextBox Text="{Binding NewProjectBudget, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,10"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Cancel" Command="{Binding OpenAddProjectCommand}" Background="Transparent" BorderBrush="#475569" Foreground="#94A3B8" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="Save Project" Command="{Binding SaveProjectCommand}" Background="#2563EB" BorderBrush="#3B82F6" Foreground="White" Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Add Milestone Modal Overlay -->
        <Grid Grid.ColumnSpan="3" Background="#80000000" Visibility="{Binding IsAddMilestoneOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Width="460" Padding="20" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Add Project Milestone" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,14"/>

                    <TextBlock Text="Milestone Title *" FontSize="11" Foreground="#94A3B8"/>
                    <TextBox Text="{Binding NewMilestoneTitle, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,10"/>

                    <TextBlock Text="Description" FontSize="11" Foreground="#94A3B8"/>
                    <TextBox Text="{Binding NewMilestoneDescription, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,10"/>

                    <TextBlock Text="Amount" FontSize="11" Foreground="#94A3B8"/>
                    <TextBox Text="{Binding NewMilestoneAmount, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,10"/>

                    <TextBlock Text="Due Date (yyyy-MM-dd)" FontSize="11" Foreground="#94A3B8"/>
                    <DatePicker SelectedDate="{Binding NewMilestoneDueDate}" Margin="0,2,0,10"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Cancel" Command="{Binding OpenAddMilestoneCommand}" Background="Transparent" BorderBrush="#475569" Foreground="#94A3B8" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="Save Milestone" Command="{Binding SaveMilestoneCommand}" Background="#2563EB" BorderBrush="#3B82F6" Foreground="White" Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
