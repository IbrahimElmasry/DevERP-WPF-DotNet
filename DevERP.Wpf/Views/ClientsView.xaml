<UserControl x:Class="DevERP.Desktop.Views.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">
    <Grid Margin="24">
        <!-- Main Layout: Left Clients Master List, Right Details & Projects -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Clients List -->
        <Border Grid.Column="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header & Add Button -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Clients" FontSize="18" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Command="{Binding OpenAddClientCommand}"
                            Background="#2563EB" BorderBrush="#3B82F6" Foreground="White" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,4,0"/>
                            <TextBlock Text="New" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Search Input with rounded border -->
                <Border Grid.Row="1" CornerRadius="8" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,12" Padding="2">
                    <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                Background="Transparent" BorderThickness="0" Foreground="#F8FAFC" Padding="8,4"
                                PlaceholderText="Search by name, company..."/>
                </Border>

                <!-- Client List View -->
                <ListBox Grid.Row="2" ItemsSource="{Binding FilteredClients}" SelectedItem="{Binding SelectedClient}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="6,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="{Binding Company}" FontSize="11" Foreground="#94A3B8"
                                               Visibility="{Binding Company, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding Email}" FontSize="11" Foreground="#64748B"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Right Column: Client & Project Details -->
        <Border Grid.Column="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="20">
            <Grid>
                <!-- If no client selected -->
                <TextBlock Text="Select a client from the list or add a new client to view projects and milestones."
                           FontSize="14" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding SelectedClient, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}"/>

                <!-- Client Content -->
                <Grid Visibility="{Binding SelectedClient, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Client Header -->
                        <RowDefinition Height="Auto"/> <!-- Projects Ribbon -->
                        <RowDefinition Height="*"/>    <!-- Selected Project Milestones -->
                    </Grid.RowDefinitions>

                    <!-- Client Header Information -->
                    <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SelectedClient.Name}" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding SelectedClient.Company, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="{Binding SelectedClient.Company}" FontSize="11" Foreground="#38BDF8"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding SelectedClient.Email}" FontSize="12" Foreground="#94A3B8" Margin="0,0,16,0"/>
                                    <TextBlock Text="{Binding SelectedClient.Phone}" FontSize="12" Foreground="#94A3B8" Margin="0,0,16,0"/>
                                    <TextBlock Text="{Binding SelectedClient.Address}" FontSize="12" Foreground="#64748B"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding OpenAddProjectCommand}" Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC" Padding="10,5">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,6,0" Foreground="#38BDF8"/>
                                        <TextBlock Text="Add Project" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Projects Tab / Ribbon -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Client Projects" FontSize="14" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>

                        <ListBox Grid.Row="1" ItemsSource="{Binding ClientProjects}" SelectedItem="{Binding SelectedProject}"
                                 Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,10,6" MinWidth="180">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Border Background="#0F172A" CornerRadius="4" Padding="4,1" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Status}" FontSize="10"
                                                               Foreground="{Binding Status, Converter={StaticResource ProjectStatusToBrushConverter}}"/>
                                                </Border>
                                                <TextBlock FontSize="11" Foreground="#94A3B8">
                                                    <Run Text="Budget: "/>
                                                    <Run Text="{Binding TotalBudget, StringFormat={}{0:N0}}" FontWeight="Bold" Foreground="#38BDF8"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Milestones Section for Selected Project -->
                    <Border Grid.Row="2" Background="#0B132B" BorderBrush="#1C2541" BorderThickness="1" CornerRadius="8" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Milestone Header & Actions -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Project Milestones &amp; Billing" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="{Binding SelectedProject.Name, StringFormat={}({0})}" FontSize="13" Foreground="#38BDF8" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button Command="{Binding OpenAddMilestoneCommand}" Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC" Padding="10,5" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,6,0" Foreground="#38BDF8"/>
                                            <TextBlock Text="Add Milestone" FontSize="12"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Direct Action: Generate Invoice From Selected Milestones -->
                                    <Button Command="{Binding GenerateInvoiceFromMilestonesCommand}"
                                            Background="#059669" BorderBrush="#10B981" Foreground="White" Padding="12,5">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ReceiptMoney24" FontSize="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Generate Invoice from Selected" FontSize="12" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Milestone List -->
                            <ListView Grid.Row="1" ItemsSource="{Binding ProjectMilestones}" Background="Transparent" BorderThickness="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="6,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/> <!-- Selection Checkbox for Invoicing -->
                                                    <ColumnDefinition Width="*"/>    <!-- Milestone Info -->
                                                    <ColumnDefinition Width="Auto"/> <!-- Status & Completion -->
                                                    <ColumnDefinition Width="Auto"/> <!-- Amount -->
                                                </Grid.ColumnDefinitions>

                                                <!-- Checkbox for invoice selection -->
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0"
                                                          IsEnabled="{Binding Milestone.IsInvoiced, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}"/>

                                                <!-- Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Milestone.Title}" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0"
                                                                Visibility="{Binding Milestone.IsInvoiced, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="INVOICED" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Milestone.Description}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="10" Foreground="#64748B" Margin="0,2,0,0">
                                                        <Run Text="Due: "/>
                                                        <Run Text="{Binding Milestone.DueDate, StringFormat={}{0:yyyy-MM-dd}}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Completion button/toggle -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,16,0">
                                                    <Button Command="{Binding DataContext.ToggleMilestoneCompleteCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#1E293B" BorderBrush="#334155" Padding="8,4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="Checkmark24" FontSize="12" Margin="0,0,4,0"
                                                                           Foreground="{Binding Milestone.IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <TextBlock Text="{Binding Milestone.IsCompleted, StringFormat={}{0}}" FontSize="11" Foreground="#94A3B8"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>

                                                <!-- Amount -->
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right">
                                                    <Run Text="{Binding Milestone.Amount, StringFormat={}{0:N2}}"/>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Add Client Modal Overlay -->
        <Grid Grid.ColumnSpan="3" Background="#80000000" Visibility="{Binding IsAddClientOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Width="460" Padding="20" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Add New Client" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,14"/>

                    <TextBlock Text="Client / Contact Name *" FontSize="11" Foreground="#94A3B8"/>
                    <TextBox Text="{Binding NewClientName, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,10"/>

                    <TextBlock Text="Company Name" FontSize="11" Foreground="#94A3B8"/>
                    <TextBox Text="{Binding NewClientCompany, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,10"/>

                    <TextBlock Text="Email Address" FontSize="11" Foreground="#94A3B8"/>
                    <TextBox Text="{Binding NewClientEmail, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,10"/>

                    <TextBlock Text="Phone" FontSize="11" Foreground="#94A3B8"/>
                    <TextBox Text="{Binding NewClientPhone, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,10"/>

                    <TextBlock Text="Billing Address" FontSize="11" Foreground="#94A3B8"/>
                    <TextBox Text="{Binding NewClientAddress, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,10"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Cancel" Command="{Binding OpenAddClientCommand}" Background="Transparent" BorderBrush="#475569" Foreground="#94A3B8" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="Save Client" Command="{Binding SaveClientCommand}" Background="#2563EB" BorderBrush="#3B82F6" Foreground="White" Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Add Project Modal Overlay -->
        <Grid Grid.ColumnSpan="3" Background="#80000000" Visibility="{Binding IsAddProjectOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Width="460" Padding="20" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Add New Project" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,14"/>

                    <TextBlock Text="Project Name *" FontSize="11" Foreground="#94A3B8"/>
                    <TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,10"/>

                    <TextBlock Text="Description" FontSize="11" Foreground="#94A3B8"/>
                    <TextBox Text="{Binding NewProjectDescription, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,10"/>

                    <TextBlock Text="Total Budget" FontSize="11" Foreground="#94A3B8"/>
                    <TextBox Text="{Binding NewProjectBudget, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,10"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Cancel" Command="{Binding OpenAddProjectCommand}" Background="Transparent" BorderBrush="#475569" Foreground="#94A3B8" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="Save Project" Command="{Binding SaveProjectCommand}" Background="#2563EB" BorderBrush="#3B82F6" Foreground="White" Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Add Milestone Modal Overlay -->
        <Grid Grid.ColumnSpan="3" Background="#80000000" Visibility="{Binding IsAddMilestoneOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Width="460" Padding="20" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Add Project Milestone" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,14"/>

                    <TextBlock Text="Milestone Title *" FontSize="11" Foreground="#94A3B8"/>
                    <TextBox Text="{Binding NewMilestoneTitle, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,10"/>

                    <TextBlock Text="Description" FontSize="11" Foreground="#94A3B8"/>
                    <TextBox Text="{Binding NewMilestoneDescription, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,10"/>

                    <TextBlock Text="Amount" FontSize="11" Foreground="#94A3B8"/>
                    <TextBox Text="{Binding NewMilestoneAmount, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,10"/>

                    <TextBlock Text="Due Date (yyyy-MM-dd)" FontSize="11" Foreground="#94A3B8"/>
                    <DatePicker SelectedDate="{Binding NewMilestoneDueDate}" Margin="0,2,0,10"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Cancel" Command="{Binding OpenAddMilestoneCommand}" Background="Transparent" BorderBrush="#475569" Foreground="#94A3B8" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="Save Milestone" Command="{Binding SaveMilestoneCommand}" Background="#2563EB" BorderBrush="#3B82F6" Foreground="White" Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
