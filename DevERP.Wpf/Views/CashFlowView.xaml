<UserControl x:Class="DevERP.Desktop.Views.CashFlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Top Actions -->
            <RowDefinition Height="Auto"/> <!-- Summary Cards -->
            <RowDefinition Height="Auto"/> <!-- Filter Bar -->
            <RowDefinition Height="*"/>    <!-- Transactions Table -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Cash Flow Ledger" FontSize="22" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                <TextBlock Text="Track developer revenues, server costs, SaaS subscriptions, taxes, and personal drawings." FontSize="13" Foreground="#94A3B8" Margin="0,3,0,0"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Command="{Binding RefreshCommand}" Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC" Padding="12,6" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,6,0" Foreground="#38BDF8"/>
                        <TextBlock Text="Refresh" FontSize="12"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ExportCsvCommand}" Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC" Padding="12,6" Margin="0,0,10,0" ToolTip="Export cash flow records to CSV">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowDownload24" Margin="0,0,6,0" Foreground="#10B981"/>
                        <TextBlock Text="Export CSV" FontSize="12"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding OpenAddTransactionCommand}"
                        Background="#2563EB" BorderBrush="#3B82F6" Foreground="White" Padding="14,6">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Record Transaction" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Summary KPI Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Inflow -->
            <Border Grid.Column="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#064E3B" CornerRadius="6" Padding="8" Margin="0,0,12,0" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowTrendingLines24" Foreground="#34D399" FontSize="20"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Total Filtered Inflows" FontSize="11" Foreground="#94A3B8"/>
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0">
                            <Run Text="+"/>
                            <Run Text="{Binding TotalInflows, StringFormat={}{0:N2}}"/>
                            <Run Text="{Binding BaseCurrency}" FontSize="11"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Total Outflow -->
            <Border Grid.Column="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#4C0519" CornerRadius="6" Padding="8" Margin="0,0,12,0" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowDown24" Foreground="#FB7185" FontSize="20"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Total Filtered Outflows" FontSize="11" Foreground="#94A3B8"/>
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="#F43F5E" Margin="0,2,0,0">
                            <Run Text="-"/>
                            <Run Text="{Binding TotalOutflows, StringFormat={}{0:N2}}"/>
                            <Run Text="{Binding BaseCurrency}" FontSize="11"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Net Flow -->
            <Border Grid.Column="4" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#1E1B4B" CornerRadius="6" Padding="8" Margin="0,0,12,0" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Vault24" Foreground="#818CF8" FontSize="20"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Net Realized Flow" FontSize="11" Foreground="#94A3B8"/>
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,0">
                            <Run Text="{Binding NetFlow, StringFormat={}{0:N2}}"/>
                            <Run Text="{Binding BaseCurrency}" FontSize="11"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Filters Strip: Type, Category, Currency, Search -->
        <Border Grid.Row="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Type Filter -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Flow Type" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                    <ComboBox SelectedValue="{Binding TypeFilter}" SelectedValuePath="Content" Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC">
                        <ComboBoxItem Content="All" IsSelected="True"/>
                        <ComboBoxItem Content="Inflow"/>
                        <ComboBoxItem Content="Outflow"/>
                    </ComboBox>
                </StackPanel>

                <!-- Category Filter -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Category" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                    <ComboBox SelectedValue="{Binding CategoryFilter}" SelectedValuePath="Content" Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC">
                        <ComboBoxItem Content="All" IsSelected="True"/>
                        <ComboBoxItem Content="Client Payment"/>
                        <ComboBoxItem Content="VPS/Tools"/>
                        <ComboBoxItem Content="Tax"/>
                        <ComboBoxItem Content="Personal"/>
                        <ComboBoxItem Content="Software Licenses"/>
                        <ComboBoxItem Content="Hardware"/>
                        <ComboBoxItem Content="Office"/>
                    </ComboBox>
                </StackPanel>

                <!-- Currency Filter -->
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Currency" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                    <ComboBox SelectedValue="{Binding CurrencyFilter}" SelectedValuePath="Content" Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC">
                        <ComboBoxItem Content="All" IsSelected="True"/>
                        <ComboBoxItem Content="EGP"/>
                        <ComboBoxItem Content="USD"/>
                        <ComboBoxItem Content="EUR"/>
                    </ComboBox>
                </StackPanel>

                <!-- Search -->
                <StackPanel Grid.Column="6">
                    <TextBlock Text="Search Description or Reference" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                    <Border CornerRadius="8" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Padding="2">
                        <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC"
                                    Padding="8,4"
                                    PlaceholderText="Type description, INV ref, invoice #..."/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Ledger Table / DataGrid with Alternating Row Tints -->
        <Border Grid.Row="3" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14">
            <DataGrid ItemsSource="{Binding FilteredTransactions}" AutoGenerateColumns="False" CanUserAddRows="False"
                      Background="Transparent" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#1E293B" AlternationCount="2"
                      RowBackground="#0E1626" AlternatingRowBackground="#131F33">
                <DataGrid.Columns>
                    <!-- Date -->
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" Width="110"/>

                    <!-- Prominent Type Pill -->
                    <DataGridTemplateColumn Header="Type" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="8,3" HorizontalAlignment="Left"
                                        BorderThickness="1"
                                        BorderBrush="{Binding Type, Converter={StaticResource TransactionTypeToBorderBrushConverter}}"
                                        Background="{Binding Type, Converter={StaticResource TransactionTypeToBackgroundConverter}}">
                                    <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="ExtraBold"
                                               Foreground="{Binding Type, Converter={StaticResource TransactionTypeToBrushConverter}}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Category -->
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140"/>

                    <!-- Description -->
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>

                    <!-- Reference -->
                    <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="130"/>

                    <!-- Original Amount -->
                    <DataGridTemplateColumn Header="Original Amount" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock TextAlignment="Right" FontSize="12" FontWeight="Bold"
                                           Foreground="{Binding Type, Converter={StaticResource TransactionTypeToBrushConverter}}">
                                    <Run Text="{Binding Type, Converter={StaticResource TransactionTypeToPrefixConverter}}"/>
                                    <Run Text="{Binding Amount, StringFormat={}{0:N2}}"/>
                                    <Run Text="{Binding Currency}" FontSize="10"/>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Base Currency Amount -->
                    <DataGridTemplateColumn Header="Base Equivalent" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock TextAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8">
                                    <Run Text="{Binding AmountInBaseCurrency, StringFormat={}{0:N2}}"/>
                                    <Run Text="EGP" FontSize="10" Foreground="#64748B"/>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Delete button -->
                    <DataGridTemplateColumn Width="45">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.DeleteTransactionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" Content="✕" Background="Transparent" BorderThickness="0"
                                        Foreground="#EF4444" FontSize="12" Cursor="Hand" Padding="4"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Record Transaction Modal Overlay -->
        <Grid Grid.RowSpan="4" Background="#80000000" Visibility="{Binding IsAddTransactionOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Width="480" Padding="20" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Record Cash Flow Transaction" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Command="{Binding CloseAddTransactionCommand}"
                                Content="✕" Background="Transparent" BorderThickness="0"
                                Foreground="#94A3B8" FontSize="14" Cursor="Hand" Padding="4"/>
                    </Grid>

                    <!-- Type Radio Buttons -->
                    <TextBlock Text="Transaction Type *" FontSize="11" Foreground="#94A3B8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                        <RadioButton Content="Inflow (+ Revenue)" IsChecked="{Binding IsNewTxInflow}" Foreground="#10B981" Margin="0,0,16,0" Style="{x:Null}"/>
                        <RadioButton Content="Outflow (- Expense)" IsChecked="{Binding IsNewTxOutflow}" Foreground="#F43F5E" Style="{x:Null}"/>
                    </StackPanel>

                    <!-- Amount & Currency -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Amount *" FontSize="11" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding NewTxAmount}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Currency" FontSize="11" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding NewTxCurrency}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="FX Rate" FontSize="11" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding NewTxExchangeRate}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Date & Category -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Date" FontSize="11" Foreground="#94A3B8"/>
                            <DatePicker SelectedDate="{Binding NewTxDate}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Category" FontSize="11" Foreground="#94A3B8"/>
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding NewTxCategory}"
                                      Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Description *" FontSize="11" Foreground="#94A3B8"/>
                    <TextBox Text="{Binding NewTxDescription}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,10"/>

                    <TextBlock Text="Reference (e.g. Receipt #, Invoice #, Transfer ID)" FontSize="11" Foreground="#94A3B8"/>
                    <TextBox Text="{Binding NewTxReference}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,2,0,14"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CloseAddTransactionCommand}" Background="Transparent" BorderBrush="#475569" Foreground="#94A3B8" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="Save Transaction" Command="{Binding SaveTransactionCommand}" Background="#2563EB" BorderBrush="#3B82F6" Foreground="White" Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
