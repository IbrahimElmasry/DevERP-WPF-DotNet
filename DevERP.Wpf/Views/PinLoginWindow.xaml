<ui:FluentWindow x:Class="DevERP.Desktop.Views.PinLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="DevERP — Enter 4-Digit Security PIN"
        Icon="../Assets/app.ico"
        Height="730" Width="440"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Foreground="#F8FAFC"
        Background="#080D18"
        ResizeMode="NoResize"
        Focusable="True"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Luxury Dialer Keypad Button Style -->
        <Style x:Key="PinKeypadButtonStyle" TargetType="ui:Button">
            <Setter Property="Width" Value="66"/>
            <Setter Property="Height" Value="66"/>
            <Setter Property="CornerRadius" Value="33"/>
            <Setter Property="Background" Value="#152136"/>
            <Setter Property="BorderBrush" Value="#253550"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="PinAuxButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource PinKeypadButtonStyle}">
            <Setter Property="Background" Value="#101A2C"/>
            <Setter Property="BorderBrush" Value="#1F2D44"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- TitleBar -->
            <RowDefinition Height="*"/>    <!-- Centered Card -->
        </Grid.RowDefinitions>

        <!-- Windows 11 Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="DevERP Security Vault" Height="36">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Border Background="#1E293B" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="OFFLINE VAULT" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Main Card Container -->
        <Grid Grid.Row="1" Margin="24,6,24,20">
            <Border Background="#0E1626" BorderBrush="#1C2B44" BorderThickness="1" CornerRadius="20" Padding="24,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header / Brand & Avatar -->
                        <RowDefinition Height="Auto"/> <!-- PIN Indicators -->
                        <RowDefinition Height="Auto"/> <!-- Error Message -->
                        <RowDefinition Height="Auto"/> <!-- Numeric Keypad -->
                        <RowDefinition Height="Auto"/> <!-- Architect Branding Badge -->
                        <RowDefinition Height="Auto"/> <!-- Bottom Hint -->
                    </Grid.RowDefinitions>

                    <!-- Header: Brand & Identity -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <!-- Glowing Shield / Lock Badge -->
                        <Border Width="60" Height="60" CornerRadius="30" BorderBrush="#38BDF8" BorderThickness="2" Margin="0,0,0,12" HorizontalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0369A1" Offset="0"/>
                                    <GradientStop Color="#0F172A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="26" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- User Name -->
                        <TextBlock x:Name="TxtDeveloperName" Text="Eng. Ibrahim Tarek" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                        
                        <!-- Role / Subtitle -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                            <Border Background="#064E3B" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                <TextBlock Text="PROTECTED" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                            </Border>
                            <TextBlock Text="Enter 4-digit PIN to access DevERP" FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- PIN Indicators (4 Prominent Dots) -->
                    <StackPanel Grid.Row="1" x:Name="PinDotsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,8">
                        <Border x:Name="Dot1" Width="22" Height="22" CornerRadius="11" Background="#162238" BorderBrush="#33486E" BorderThickness="2" Margin="10,0"/>
                        <Border x:Name="Dot2" Width="22" Height="22" CornerRadius="11" Background="#162238" BorderBrush="#33486E" BorderThickness="2" Margin="10,0"/>
                        <Border x:Name="Dot3" Width="22" Height="22" CornerRadius="11" Background="#162238" BorderBrush="#33486E" BorderThickness="2" Margin="10,0"/>
                        <Border x:Name="Dot4" Width="22" Height="22" CornerRadius="11" Background="#162238" BorderBrush="#33486E" BorderThickness="2" Margin="10,0"/>
                    </StackPanel>

                    <!-- Error Notice (Fixed Height prevents jumping) -->
                    <TextBlock Grid.Row="2" x:Name="TxtErrorMessage" Text="" FontSize="12" FontWeight="SemiBold" Foreground="#EF4444"
                               HorizontalAlignment="Center" TextAlignment="Center" Height="20" Margin="0,0,0,8"/>

                    <!-- Numeric Keypad (Cohesive, Centered Grid) -->
                    <Grid Grid.Row="3" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="68"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="68"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="68"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="68"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="68"/>
                        </Grid.ColumnDefinitions>

                        <!-- Row 1: 1, 2, 3 -->
                        <ui:Button Grid.Row="0" Grid.Column="0" Content="1" Tag="1" Click="KeypadButton_Click" Style="{StaticResource PinKeypadButtonStyle}"/>
                        <ui:Button Grid.Row="0" Grid.Column="2" Content="2" Tag="2" Click="KeypadButton_Click" Style="{StaticResource PinKeypadButtonStyle}"/>
                        <ui:Button Grid.Row="0" Grid.Column="4" Content="3" Tag="3" Click="KeypadButton_Click" Style="{StaticResource PinKeypadButtonStyle}"/>

                        <!-- Row 2: 4, 5, 6 -->
                        <ui:Button Grid.Row="2" Grid.Column="0" Content="4" Tag="4" Click="KeypadButton_Click" Style="{StaticResource PinKeypadButtonStyle}"/>
                        <ui:Button Grid.Row="2" Grid.Column="2" Content="5" Tag="5" Click="KeypadButton_Click" Style="{StaticResource PinKeypadButtonStyle}"/>
                        <ui:Button Grid.Row="2" Grid.Column="4" Content="6" Tag="6" Click="KeypadButton_Click" Style="{StaticResource PinKeypadButtonStyle}"/>

                        <!-- Row 3: 7, 8, 9 -->
                        <ui:Button Grid.Row="4" Grid.Column="0" Content="7" Tag="7" Click="KeypadButton_Click" Style="{StaticResource PinKeypadButtonStyle}"/>
                        <ui:Button Grid.Row="4" Grid.Column="2" Content="8" Tag="8" Click="KeypadButton_Click" Style="{StaticResource PinKeypadButtonStyle}"/>
                        <ui:Button Grid.Row="4" Grid.Column="4" Content="9" Tag="9" Click="KeypadButton_Click" Style="{StaticResource PinKeypadButtonStyle}"/>

                        <!-- Row 4: Clear, 0, Backspace -->
                        <ui:Button Grid.Row="6" Grid.Column="0" Content="C" Click="ClearButton_Click" Style="{StaticResource PinAuxButtonStyle}"/>
                        <ui:Button Grid.Row="6" Grid.Column="2" Content="0" Tag="0" Click="KeypadButton_Click" Style="{StaticResource PinKeypadButtonStyle}"/>
                        <ui:Button Grid.Row="6" Grid.Column="4" Click="BackspaceButton_Click" Style="{StaticResource PinAuxButtonStyle}">
                            <ui:SymbolIcon Symbol="Backspace24" FontSize="19"/>
                        </ui:Button>
                    </Grid>

                    <!-- Architect Branding Badge (Created by Eng. Ibrahim Tarek) -->
                    <Border Grid.Row="4" Background="#0A111E" BorderBrush="#1A2840" BorderThickness="1" CornerRadius="10" Padding="12,8" HorizontalAlignment="Center" Width="310">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#17253D" CornerRadius="13" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Code24" FontSize="13" Foreground="#38BDF8"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Created by " FontSize="11" Foreground="#94A3B8"/>
                                    <TextBlock Text="Eng. Ibrahim Tarek" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                </StackPanel>
                                <TextBlock Text="Lead Systems Architect &amp; Software Engineer" FontSize="9" Foreground="#64748B"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Bottom Hint -->
                    <TextBlock Grid.Row="5" x:Name="TxtHint" Text="Default PIN: 1234 • Configurable in Settings" FontSize="10" Foreground="#475569" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
