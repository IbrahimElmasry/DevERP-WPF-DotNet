<UserControl x:Class="DevERP.Desktop.Views.InvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">
    <UserControl.Resources>
        <Style x:Key="FilterPillRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#141E30" BorderBrush="#253550" BorderThickness="1" CornerRadius="12" Padding="10,4">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C2B44"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0284C7"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Invoices List & Filter -->
        <Border Grid.Column="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header & Create Button -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Invoices" FontSize="18" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding ExportCsvCommand}"
                                Background="#1E293B" BorderBrush="#334155" Foreground="#94A3B8" Padding="8,5" Margin="0,0,6,0" ToolTip="Export Invoices to CSV">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,4,0" Foreground="#38BDF8"/>
                                <TextBlock Text="CSV" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenCreateInvoiceCommand}"
                                Background="#2563EB" BorderBrush="#3B82F6" Foreground="White" Padding="10,5">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,4,0"/>
                                <TextBlock Text="New Invoice" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Status Filter Pills -->
                <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                    <RadioButton Content="All" IsChecked="{Binding IsFilterAll}" GroupName="InvStatus" Style="{StaticResource FilterPillRadioStyle}"/>
                    <RadioButton Content="Sent" IsChecked="{Binding IsFilterSent}" GroupName="InvStatus" Style="{StaticResource FilterPillRadioStyle}"/>
                    <RadioButton Content="Paid" IsChecked="{Binding IsFilterPaid}" GroupName="InvStatus" Style="{StaticResource FilterPillRadioStyle}"/>
                    <RadioButton Content="Overdue" IsChecked="{Binding IsFilterOverdue}" GroupName="InvStatus" Style="{StaticResource FilterPillRadioStyle}"/>
                    <RadioButton Content="Draft" IsChecked="{Binding IsFilterDraft}" GroupName="InvStatus" Style="{StaticResource FilterPillRadioStyle}"/>
                </WrapPanel>

                <!-- Search Input with rounded border -->
                <Border Grid.Row="2" CornerRadius="8" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,12" Padding="2">
                    <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                Background="Transparent" BorderThickness="0" Foreground="#F8FAFC" Padding="8,4"
                                PlaceholderText="Search invoice #, client..."/>
                </Border>

                <!-- Invoices List with Alternating Row Tints -->
                <ListBox Grid.Row="3" ItemsSource="{Binding FilteredInvoices}" SelectedItem="{Binding SelectedInvoice}"
                         Background="Transparent" BorderThickness="0" AlternationCount="2">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="8" Background="#0C1322" BorderBrush="#1E293B" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                <Setter TargetName="Bd" Property="Background" Value="#111B30"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#131F33"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="6,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Top: Number and Status Pill -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="{Binding InvoiceNumber}" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                                        <TextBlock Text="{Binding Client.Name}" FontSize="12" Foreground="#E2E8F0" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Prominent Status Pill -->
                                    <Border Grid.Row="0" Grid.Column="1" CornerRadius="4" Padding="7,2" VerticalAlignment="Top"
                                            BorderThickness="1"
                                            BorderBrush="{Binding Status, Converter={StaticResource InvoiceStatusToBorderBrushConverter}}"
                                            Background="{Binding Status, Converter={StaticResource InvoiceStatusToBackgroundConverter}}">
                                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold"
                                                   Foreground="{Binding Status, Converter={StaticResource InvoiceStatusToBrushConverter}}"/>
                                    </Border>

                                    <!-- Bottom: Due Date & Amount -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,0,0" FontSize="11" Foreground="#64748B">
                                        <Run Text="Due: "/>
                                        <Run Text="{Binding DueDate, StringFormat={}{0:yyyy-MM-dd}}" Foreground="#94A3B8"/>
                                    </TextBlock>

                                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Right">
                                        <Run Text="{Binding TotalAmount, StringFormat={}{0:N2}}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding Currency}" FontSize="10" Foreground="#94A3B8"/>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Right Column: Invoice Details & Actions -->
        <Border Grid.Column="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <!-- Empty Placeholder -->
                    <TextBlock Text="Select an invoice from the list to preview details or export PDF."
                               FontSize="14" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding SelectedInvoice, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}"/>

                    <!-- Invoice Content -->
                    <Grid Visibility="{Binding SelectedInvoice, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header & Action Buttons -->
                            <RowDefinition Height="Auto"/> <!-- Metadata & Bill To -->
                            <RowDefinition Height="Auto"/> <!-- Line Items Table -->
                            <RowDefinition Height="Auto"/> <!-- Totals & Footer -->
                        </Grid.RowDefinitions>

                        <!-- Top Actions Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedInvoice.InvoiceNumber}" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <Border CornerRadius="4" Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center"
                                        BorderThickness="1"
                                        BorderBrush="{Binding SelectedInvoice.Status, Converter={StaticResource InvoiceStatusToBorderBrushConverter}}"
                                        Background="{Binding SelectedInvoice.Status, Converter={StaticResource InvoiceStatusToBackgroundConverter}}">
                                    <TextBlock Text="{Binding SelectedInvoice.Status}" FontSize="11" FontWeight="Bold"
                                               Foreground="{Binding SelectedInvoice.Status, Converter={StaticResource InvoiceStatusToBrushConverter}}"/>
                                </Border>
                            </StackPanel>

                            <!-- Actions: Mark as Paid, WhatsApp Share, & Export PDF -->
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <!-- Mark as Paid Button -->
                                <ui:Button Command="{Binding MarkAsPaidCommand}" IsEnabled="{Binding CanMarkAsPaid}"
                                        Background="#059669" BorderBrush="#10B981" Foreground="White" Padding="12,6" Margin="0,0,10,0" CornerRadius="8" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="Mark as Paid" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </ui:Button>

                                <!-- WhatsApp Quick Share Button -->
                                <ui:Button Command="{Binding ShareWhatsAppCommand}"
                                        Background="#064E3B" BorderBrush="#059669" Foreground="#34D399" Padding="12,6" Margin="0,0,10,0" CornerRadius="8" Cursor="Hand" ToolTip="Send invoice summary &amp; coordinates via WhatsApp">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Chat24" FontSize="16" Margin="0,0,6,0" Foreground="#10B981"/>
                                        <TextBlock Text="WhatsApp" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </ui:Button>

                                <!-- Export PDF Button -->
                                <ui:Button Command="{Binding ExportPdfCommand}"
                                        Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC" Padding="12,6" CornerRadius="8" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="16" Margin="0,0,6,0" Foreground="#F43F5E"/>
                                        <TextBlock Text="Export PDF" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>
                        </Grid>

                        <!-- Invoice Metadata & Client Card -->
                        <Border Grid.Row="1" Background="#0C1322" BorderBrush="#1C273C" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Client Details -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="BILL TO" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SelectedInvoice.Client.Name}" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding SelectedInvoice.Client.Company}" FontSize="12" Foreground="#38BDF8"
                                               Visibility="{Binding SelectedInvoice.Client.Company, Converter={StaticResource NullToVisibilityConverter}}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding SelectedInvoice.Client.Email}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding SelectedInvoice.Client.Address}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Invoice Dates -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock FontSize="12" Foreground="#94A3B8">
                                        <Run Text="Issue Date: " Foreground="#64748B"/>
                                        <Run Text="{Binding SelectedInvoice.IssueDate, StringFormat={}{0:yyyy-MM-dd}}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0">
                                        <Run Text="Due Date: " Foreground="#64748B"/>
                                        <Run Text="{Binding SelectedInvoice.DueDate, StringFormat={}{0:yyyy-MM-dd}}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0">
                                        <Run Text="Currency: " Foreground="#64748B"/>
                                        <Run Text="{Binding SelectedInvoice.Currency}" FontWeight="Bold" Foreground="#38BDF8"/>
                                        <Run Text=" (Rate: " Foreground="#64748B"/>
                                        <Run Text="{Binding SelectedInvoice.ExchangeRateToBase, StringFormat={}{0:F2}}"/>
                                        <Run Text=")" Foreground="#64748B"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="#10B981" Margin="0,4,0,0"
                                               Visibility="{Binding SelectedInvoice.PaidAt, Converter={StaticResource NullToVisibilityConverter}}">
                                        <Run Text="Paid Date: "/>
                                        <Run Text="{Binding SelectedInvoice.PaidAt, StringFormat={}{0:yyyy-MM-dd}}" FontWeight="Bold"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Items Table with Perfect Column Alignment -->
                        <Border Grid.Row="2" Background="#0C1322" BorderBrush="#1C273C" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Table Header -->
                                <Grid Grid.Row="0" Margin="4,0,4,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Description" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" Text="Unit Price" FontSize="11" FontWeight="Bold" Foreground="#64748B" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="Qty" FontSize="11" FontWeight="Bold" Foreground="#64748B" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="Total" FontSize="11" FontWeight="Bold" Foreground="#64748B" TextAlignment="Right"/>
                                </Grid>

                                <!-- Items List via ItemsControl for Full Width Alignment -->
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedInvoice.Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#162238" BorderThickness="0,1,0,0" Padding="4,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="120"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Description}" FontSize="12.5" FontWeight="SemiBold" Foreground="#F1F5F9" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding UnitPrice, StringFormat={}{0:N2}}" FontSize="12" Foreground="#94A3B8" TextAlignment="Right" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Quantity, StringFormat={}{0:N0}}" FontSize="12" Foreground="#94A3B8" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding TotalPrice, StringFormat={}{0:N2}}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" TextAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <!-- Summary & Notes -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>

                            <!-- Notes -->
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="Payment Notes / Terms" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SelectedInvoice.Notes}" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Totals Card -->
                            <Border Grid.Column="1" Background="#0C1322" BorderBrush="#1C273C" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Subtotal:" FontSize="12" Foreground="#94A3B8"/>
                                        <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC">
                                            <Run Text="{Binding SelectedInvoice.SubTotal, StringFormat={}{0:N2}}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding SelectedInvoice.Currency}" FontSize="10" Foreground="#94A3B8"/>
                                        </TextBlock>
                                    </Grid>

                                    <Grid Margin="0,0,0,8" Visibility="{Binding SelectedInvoice.TaxAmount, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="Tax Amount:" FontSize="12" Foreground="#94A3B8"/>
                                        <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="#F8FAFC">
                                            <Run Text="{Binding SelectedInvoice.TaxAmount, StringFormat={}{0:N2}}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding SelectedInvoice.Currency}" FontSize="10" Foreground="#94A3B8"/>
                                        </TextBlock>
                                    </Grid>

                                    <Border BorderBrush="#1C273C" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,4,0,0">
                                        <Grid>
                                            <TextBlock Text="Total Due:" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                            <TextBlock HorizontalAlignment="Right" FontSize="18" FontWeight="Bold" Foreground="#34D399">
                                                <Run Text="{Binding SelectedInvoice.TotalAmount, StringFormat={}{0:N2}}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding SelectedInvoice.Currency}" FontSize="12" Foreground="#6EE7B7"/>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Create Invoice Modal Overlay -->
        <Grid Grid.ColumnSpan="3" Background="#80000000" Visibility="{Binding IsCreateInvoiceOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Width="600" Padding="20" VerticalAlignment="Center">
                <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Create New Invoice" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Command="{Binding CloseCreateInvoiceCommand}"
                                    Background="Transparent" BorderThickness="0" Padding="4" ToolTip="Close">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="#94A3B8"/>
                            </Button>
                        </Grid>

                        <!-- Client selection -->
                        <TextBlock Text="Select Client *" FontSize="11" Foreground="#94A3B8"/>
                        <ComboBox ItemsSource="{Binding AvailableClients}" SelectedItem="{Binding NewInvoiceClient}" DisplayMemberPath="Name"
                                  Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,3,0,10"/>

                        <!-- Invoice Number & Currency -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Invoice Number" FontSize="11" Foreground="#94A3B8"/>
                                <TextBox Text="{Binding NewInvoiceNumber}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Currency" FontSize="11" Foreground="#94A3B8"/>
                                <TextBox Text="{Binding NewInvoiceCurrency}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="FX Rate to Base" FontSize="11" Foreground="#94A3B8"/>
                                <TextBox Text="{Binding NewInvoiceExchangeRate}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Dates -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Issue Date" FontSize="11" Foreground="#94A3B8"/>
                                <DatePicker SelectedDate="{Binding NewInvoiceIssueDate}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Due Date" FontSize="11" Foreground="#94A3B8"/>
                                <DatePicker SelectedDate="{Binding NewInvoiceDueDate}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Add Line Item Box -->
                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Add Line Items" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Grid.Column="0" Text="{Binding NewItemDescription}" PlaceholderText="Item Description" Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC"/>
                                    <ui:TextBox Grid.Column="2" Text="{Binding NewItemQty}" PlaceholderText="Qty" Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC"/>
                                    <ui:TextBox Grid.Column="4" Text="{Binding NewItemUnitPrice}" PlaceholderText="Price" Background="#1E293B" BorderBrush="#334155" Foreground="#F8FAFC"/>
                                    <Button Grid.Column="6" Command="{Binding AddLineItemCommand}" Content="Add" Background="#2563EB" Foreground="White" Padding="10,4"/>
                                </Grid>

                                <!-- Existing Items in new invoice -->
                                <ItemsControl ItemsSource="{Binding NewInvoiceItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Description}" Foreground="#F1F5F9" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat={}{0:N0}}" Foreground="#94A3B8" FontSize="11" TextAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding TotalPrice, StringFormat={}{0:N2}}" Foreground="#10B981" FontWeight="Bold" FontSize="11" TextAlignment="Right"/>
                                                <Button Grid.Column="3" Command="{Binding DataContext.RemoveLineItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" Content="X" Background="Transparent" Foreground="#F43F5E" BorderThickness="0" Margin="6,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Payment Method Choice (Bank Wire / InstaPay IPN / Both) -->
                        <TextBlock Text="Accepted Payment Method on Invoice" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Bank Wire" IsChecked="{Binding IsPaymentBankWire}" GroupName="NewInvPayMethod" Foreground="#F8FAFC" Margin="0,0,16,0"/>
                                <RadioButton Content="InstaPay (IPN Egypt)" IsChecked="{Binding IsPaymentInstaPay}" GroupName="NewInvPayMethod" Foreground="#10B981" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                <RadioButton Content="Both (Wire &amp; InstaPay)" IsChecked="{Binding IsPaymentBoth}" GroupName="NewInvPayMethod" Foreground="#38BDF8" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Notes &amp; Wire Instructions" FontSize="11" Foreground="#94A3B8"/>
                        <TextBox Text="{Binding NewInvoiceNotes}" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,3,0,14" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding CloseCreateInvoiceCommand}" Background="Transparent" BorderBrush="#475569" Foreground="#94A3B8" Margin="0,0,8,0" Padding="12,6"/>
                            <Button Content="Create &amp; Issue Invoice" Command="{Binding SaveInvoiceCommand}" Background="#2563EB" BorderBrush="#3B82F6" Foreground="White" Padding="14,6"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
